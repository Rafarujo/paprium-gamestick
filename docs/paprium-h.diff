+static void pap_stream_close(void)
+{
+	if (pap_stream_fp) {
+		fclose(pap_stream_fp);
+		pap_stream_fp = NULL;
+	}
+	pap_stream_in_size = 0;
+	pap_stream_in_pos = 0;
+	pap_stream_data_start = 0;
+	pap_stream_rd = 0;
+	pap_stream_wr = 0;
+	pap_stream_cnt = 0;
+	pap_stream_hz = 0;
+}
+
+/* pula o ID3v2 do inicio (capa embutida pode ter alguns MB e faria o
+   decodificador varrer tudo procurando sincronismo) */
+static int pap_stream_skip_id3(FILE *fp)
+{
+	uint8_t h[10];
+	int off = 0;
+
+	if (fread(h, 1, 10, fp) == 10 && h[0] == 'I' && h[1] == 'D' && h[2] == '3') {
+		off = ((h[6] & 0x7f) << 21) | ((h[7] & 0x7f) << 14) |
+		      ((h[8] & 0x7f) << 7) | (h[9] & 0x7f);
+		off += 10;
+		if (h[5] & 0x10)   /* footer */
+			off += 10;
+	}
+
+	/* se o tamanho do ID3 nao fizer sentido, ignora o pulo */
+	if (fseek(fp, 0, SEEK_END) == 0) {
+		long size = ftell(fp);
+		if (size <= 0 || off >= size)
+			off = 0;
+	}
+
+	if (fseek(fp, off, SEEK_SET) != 0)
+		off = 0;
+	return off;
+}
+
+static int pap_stream_open(const char *path)
+{
+	pap_stream_close();
+
+	pap_stream_fp = fopen(path, "rb");
+	if (!pap_stream_fp) {
+		PAPW("mp3: nao abriu %s", path);
+		return 0;
+	}
+
+	pap_stream_data_start = pap_stream_skip_id3(pap_stream_fp);
+	mp3dec_init(&pap_stream_dec);
+	pap_stream_loops = 0;
+
+	return 1;
+}
+
+static void pap_stream_rewind(void)
+{
+	fseek(pap_stream_fp, pap_stream_data_start, SEEK_SET);
+	mp3dec_init(&pap_stream_dec);
+	pap_stream_in_size = 0;
+	pap_stream_in_pos = 0;
+	pap_stream_loops++;
+	PAPW("mp3: loop %d", pap_stream_loops);
+}
+
+/* le' mais dados do arquivo; 0 = fim (ou buffer cheio) */
+static int pap_stream_read_more(void)
+{
+	int n;
+
+	if (pap_stream_in_pos > 0) {
+		int rest = pap_stream_in_size - pap_stream_in_pos;
+		memmove(pap_stream_in, pap_stream_in + pap_stream_in_pos, rest);
+		pap_stream_in_size = rest;
+		pap_stream_in_pos = 0;
+	}
+
+	if (pap_stream_in_size >= PAPIN_BYTES)
+		return 0;
+
+	n = fread(pap_stream_in + pap_stream_in_size, 1,
+	          PAPIN_BYTES - pap_stream_in_size, pap_stream_fp);
+	if (n <= 0)
+		return 0;
+
+	pap_stream_in_size += n;
+	return 1;
+}
+
+/* decodifica um quadro MP3 para o ring; 0 se nao produziu amostras */
+static int pap_stream_decode_one(void)
+{
+	int tentativas = 0;
+	mp3dec_frame_info_t info;
+	int frames, i, ch;
+
+	for (;;) {
+		if (!pap_stream_fp)
+			return 0;
+
+		if (pap_stream_in_pos >= pap_stream_in_size) {
+			if (!pap_stream_read_more()) {
+				if (++tentativas > 2) {
+					PAPW("mp3: arquivo sem quadros validos, fecha");
+					pap_stream_close();
+					return 0;
+				}
+				pap_stream_rewind();
+				continue;
+			}
+		}
+
+		memset(&info, 0, sizeof(info));
+		frames = mp3dec_decode_frame(&pap_stream_dec,
+		                             pap_stream_in + pap_stream_in_pos,
+		                             pap_stream_in_size - pap_stream_in_pos,
+		                             pap_stream_pcm, &info);
+
+		if (info.frame_bytes <= 0) {
+			/* quadro cortado no fim do bloco: precisa de mais bytes */
+			if (!pap_stream_read_more()) {
+				if (++tentativas > 2) {
+					PAPW("mp3: fim/erro, fecha");
+					pap_stream_close();
+					return 0;
+				}
+				pap_stream_rewind();
+			}
+			continue;
+		}
+
+		pap_stream_in_pos += info.frame_bytes;
+
+		if (frames <= 0)
+			continue;
+
+		ch = info.channels;
+		if (info.hz && info.hz != pap_stream_hz) {
+			pap_stream_hz = info.hz;
+			PAPW("mp3: %d Hz %d ch", info.hz, ch);
+		}
+
+		for (i = 0; i < frames && pap_stream_cnt < PAPRING_FRAMES; i++) {
+			int16_t l = pap_stream_pcm[i * ch];
+			int16_t r = (ch > 1) ? pap_stream_pcm[i * ch + 1] : l;
+
+			pap_stream_l[pap_stream_wr] = l;
+			pap_stream_r[pap_stream_wr] = r;
+			pap_stream_wr = (pap_stream_wr + 1) % PAPRING_FRAMES;
+			pap_stream_cnt++;
+		}
+		return 1;
+	}
+}
+
+static void pap_stream_pump(void)
+{
+	int n = 0;
+
+	while (pap_stream_cnt < PAPRING_LOW && n++ < 8 && pap_stream_fp)
+		if (!pap_stream_decode_one())
+			break;
+}
+
+/* proxima amostra estereo; silencio se nao ha' musica */
+static void pap_stream_next(int *l, int *r)
+{
+	*l = 0;
+	*r = 0;
+
+	if (pap_stream_cnt < PAPRING_LOW)
+		pap_stream_pump();
+
+	if (pap_stream_cnt > 0) {
+		*l = pap_stream_l[pap_stream_rd];
+		*r = pap_stream_r[pap_stream_rd];
+		pap_stream_rd = (pap_stream_rd + 1) % PAPRING_FRAMES;
+		pap_stream_cnt--;
+	}
+}
