+#if PAPRIUM_TRACE_1FEA
+/* v9: despeja o ring de PCs + SP (ultimas instrucoes executadas). O opcode e'
+   lido da RAM do cartucho (0x0000-0xFFFF), da ROM (0x010000-0x7FFFFF) ou da
+   work RAM (0xFF0000+). A memoria do core e' byte-swapped em relacao ao .bin,
+   entao o opcode e' invertido para aparecer na ordem real. */
+static void pap_ring_dump(const char *tag, unsigned int *pcs, unsigned int *sps,
+                          unsigned int n, unsigned int tot, unsigned int *regs,
+                          unsigned int sr, unsigned int ipl, unsigned int stop,
+                          unsigned int pcv, unsigned int bad)
+{
+	unsigned int i, first;
+
+	if( n > PAP_RING_N ) first = n - PAP_RING_N; else first = 0;
+
+	PAPW("RING %s n=%u tot=%u bad=%06X sr=%u ipl=%u stop=%u pc=%06X a6=%06X a7=%08X",
+	     tag, n, tot, bad & 0xffffff, sr, ipl, stop, pcv & 0xffffff,
+	     regs[14] & 0xffffff, regs[15]);
+	PAPW("REGS d0=%08X d1=%08X d2=%08X d3=%08X d4=%08X d5=%08X d6=%08X d7=%08X",
+	     regs[0], regs[1], regs[2], regs[3],
+	     regs[4], regs[5], regs[6], regs[7]);
+	PAPW("REGS a0=%08X a1=%08X a2=%08X a3=%08X a4=%08X a5=%08X a6=%08X a7=%08X",
+	     regs[8], regs[9], regs[10], regs[11],
+	     regs[12], regs[13], regs[14], regs[15]);
+
+	for( i = first; i < n; i++ ) {
+		unsigned int k = (tot - n + i) & (PAP_RING_N - 1);
+		unsigned int pc = pcs[k] & 0xffffff;
+		unsigned int raw = 0;
+
+		if( pc < 0xFFFE )
+			raw = ((unsigned)paprium_s.ram[pc] << 8) | paprium_s.ram[pc + 1];
+		else if( pc < 0x800000 )
+			raw = ((unsigned)cart.rom[pc] << 8) | cart.rom[pc + 1];
+		else if( pc >= 0xFF0000 )
+			raw = ((unsigned)work_ram[pc & 0xFFFF] << 8) | work_ram[(pc + 1) & 0xFFFF];
+
+		/* cart.rom/ram/work_ram guardam os bytes trocados de par */
+		raw = ((raw & 0xff) << 8) | (raw >> 8);
+
+		PAPW("R %04u pc=%06X sp=%08X op=%04X%s", i, pc, sps[k], raw,
+		     (pc == (bad & 0xffffff)) ? " <BAD" : "");
+	}
+}
+#endif
